# Copy to .env and fill in. The .env file is not tracked by git.
#   cp .env.example .env

# --- Database ----------------------------------------------------------------
# The one the WeaponPaints plugin uses on the CS2 server.
DB_HOST=changeme
DB_PORT=3306
DB_NAME=changeme
DB_USER=changeme
DB_PASS=changeme

# --- Site --------------------------------------------------------------------
# Starting language: en or zh-CN.
DEFAULT_LANGUAGE=en
# Site name per language. Commented out means the built-in names are used.
#SITE_NAME_EN=CS2 Loadout Manager
#SITE_NAME_ZH_CN=CS2 饰品管理器
# Leave empty for an open site, otherwise a password is asked on entry.
SITE_ACCESS_PASSWORD=
# Leave empty to disable administrator mode.
ADMIN_PASSWORD=
# Starting theme: dark or light. Visitors can switch it in their browser.
DEFAULT_WEB_THEME=dark
TZ=Europe/Paris

# Cross-weapon paint combinations.
ENABLE_SKIN_FUSION=true
# Make the StatTrak kill count read-only. Off by default, so players set their
# own. The counter is game state the plugin maintains, and an editable field is
# an easy way to claim a record: turn this on for a public or untrusted site.
LOCK_STATTRAK_COUNT=false

# --- Login throttling --------------------------------------------------------
# Applies to the site password, the administrator password and loadout PINs,
# counted per client IP. Reaching the limit clears the failure count, so the
# lock duration is what really caps a brute force attempt: five tries every
# five minutes rather than five every minute.
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=1800
AUTH_RATE_LIMIT_LOCK_SECONDS=300

# --- Traefik -----------------------------------------------------------------
# All of these depend on your own Traefik install: take them from your static
# configuration, they have no universal default.

# Domain the site answers on.
SITE_DOMAIN=loadout.example.com
# Prefix for the Traefik router and service, unique across the instance.
TRAEFIK_ROUTER=changeme
# Entrypoint carrying HTTPS, often "https" or "websecure".
TRAEFIK_ENTRYPOINT=changeme
# Middlewares applied to the route, comma separated.
TRAEFIK_MIDDLEWARES=changeme
# TLS option set declared in your configuration.
TRAEFIK_TLS_OPTIONS=changeme
# ACME resolver declared in your configuration.
TRAEFIK_CERTRESOLVER=changeme

# --- Docker networks ---------------------------------------------------------
# Existing external networks: the one Traefik listens on, and the one shared
# with the CS2 server and its database.
TRAEFIK_NETWORK=changeme
CS2_NETWORK=changeme

# --- Misc --------------------------------------------------------------------
# Names both the built image and the running container. Change it here rather
# than in docker-compose.yml, which git tracks and would conflict on every pull.
CONTAINER_NAME=cs2-loadout-web
