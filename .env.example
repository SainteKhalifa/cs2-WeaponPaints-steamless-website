# Copier en .env et remplir. Le fichier .env n'est pas suivi par git.
#   cp .env.example .env

# --- Base de données ---------------------------------------------------------
# Celle utilisée par le plugin WeaponPaints sur le serveur CS2.
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=changeme
DB_USER=changeme
DB_PASS=changeme

# --- Site --------------------------------------------------------------------
# Langue de départ : en ou zh-CN.
DEFAULT_LANGUAGE=en
# Laisser vide pour un site ouvert, sinon mot de passe demandé à l'entrée.
SITE_ACCESS_PASSWORD=
# Laisser vide pour désactiver le mode administrateur.
ADMIN_PASSWORD=
WEB_STYLE_DARK=true
TZ=Europe/Paris

# --- Traefik -----------------------------------------------------------------
# Toutes ces valeurs dépendent de ton installation Traefik : reprends-les de
# ta configuration statique, elles n'ont pas de valeur par défaut universelle.

# Domaine sur lequel le site répond.
SITE_DOMAIN=loadout.example.com
# Préfixe des routeurs et services Traefik, unique sur l'instance.
TRAEFIK_ROUTER=changeme
# Point d'entrée qui porte le HTTPS, souvent « https » ou « websecure ».
TRAEFIK_ENTRYPOINT=changeme
# Middlewares appliqués à la route, séparés par des virgules.
TRAEFIK_MIDDLEWARES=changeme
# Jeu d'options TLS déclaré dans ta configuration.
TRAEFIK_TLS_OPTIONS=changeme
# Résolveur ACME déclaré dans ta configuration.
TRAEFIK_CERTRESOLVER=changeme

# --- Réseaux Docker ----------------------------------------------------------
# Réseaux externes déjà existants : celui où écoute Traefik, et celui partagé
# avec le serveur CS2 et sa base de données.
TRAEFIK_NETWORK=changeme
CS2_NETWORK=changeme

# --- Divers ------------------------------------------------------------------
CONTAINER_NAME=cs2-loadout-web
